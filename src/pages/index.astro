---
import AsciiPet from '../components/AsciiPet.astro';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>adhd.pet</title>
  </head>
  <body>
    <main>
      <AsciiPet />
      <p class="foot">
        <span class="item">adhd.pet</span>
        <span class="item"><span class="dot">&bull;</span> <a href="https://github.com/avitoras/adhd.pet">source</a></span>
        <span class="item"><span class="dot">&bull;</span> thanks for the domain <a href="https://wexu.moe">wexu.moe</a></span>
      </p>
    </main>
  </body>
</html>

<style>
  @font-face {
    font-family: 'Cascadia Mono';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/cascadia-mono-latin-400-normal.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
      U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122,
      U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Cascadia Mono';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/cascadia-mono-cyrillic-400-normal.woff2') format('woff2');
    unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
  }
  :root {
    color-scheme: light dark;
  }
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: light-dark(#faf7f2, #14120f);
    color: light-dark(#2b241c, #e8e0d4);
    font-family:
      'Cascadia Mono', ui-monospace, 'Cascadia Code', 'SF Mono', Menlo,
      Consolas, 'DejaVu Sans Mono', 'Liberation Mono', monospace;
  }
  main {
    text-align: center;
    padding: 2rem 1rem;
  }
  .foot {
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    opacity: 0.65;
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.6em;
    row-gap: 0.4em;
  }
  .foot .item {
    white-space: nowrap;
  }
  .foot .dot {
    display: inline-block;
    transform: translateY(1px);
  }
  @media (max-width: 560px) {
    .foot .item:last-child {
      flex-basis: 100%;
    }
    .foot .item:last-child .dot {
      display: none;
    }
  }
  .foot a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .foot a:hover {
    opacity: 1;
    text-decoration-style: wavy;
  }
</style>
